{# Composants réutilisables de la plateforme #}

{# Tuile chiffre clé : libellé, valeur (comptée si numérique), suffixe, note #}
{% macro kpi(label, value, suffix = '', note = null, icon = null) %}
    <article class="kpi" data-controller="tilt" data-action="pointermove->tilt#move pointerleave->tilt#reset">
        <span class="kpi-label">{% if icon %}<span aria-hidden="true">{{ icon }}</span> {% endif %}{{ label }}</span>
        <span class="kpi-value">
            {%- if value is same as(null) -%}—
            {%- elseif value matches '/^\\d+$/' -%}<span data-count="{{ value }}">{{ value|number_format(0, ',', ' ') }}</span>
            {%- else -%}{{ value }}{%- endif -%}
            {%- if suffix and value is not same as(null) %}<small>{{ suffix }}</small>{% endif -%}
        </span>
        {% if note %}<span class="kpi-note">{{ note }}</span>{% endif %}
    </article>
{% endmacro %}

{# Statut de session : icône + libellé (jamais la couleur seule) #}
{% macro status(session) %}
    {% set icons = { planifiee: '🗓', en_cours: '●', terminee: '✓' } %}
    <span class="pill pill-{{ session.status }}">{{ icons[session.status] }} {{ session.statusLabel }}</span>
{% endmacro %}

{# Barre horizontale de pourcentage avec valeur #}
{% macro bar(rate, highlight = false) %}
    <span class="rate">
        <span class="rate-track"><span class="rate-fill {{ highlight ? 'is-low' }}" style="--w: {{ rate ?? 0 }}%"></span></span>
        <span class="rate-value">{{ rate is null ? '—' : rate ~ ' %' }}</span>
    </span>
{% endmacro %}

{# Réussite par thématique, du plus faible au plus fort ; le plus faible est signalé #}
{% macro themes(list, weakestKey = null) %}
    <ul class="themes">
        {% for theme in list %}
            <li class="theme" style="--i: {{ loop.index0 }}" title="{{ theme.label }} : {{ theme.rate }} %">
                <span class="theme-label">{% if theme.key == weakestKey %}⚠️ {% endif %}{{ theme.label }}</span>
                <span class="theme-track"><span class="theme-fill {{ theme.key == weakestKey ? 'is-low' }}" style="--w: {{ theme.rate }}%"></span></span>
                <span class="theme-value"><span data-count="{{ theme.rate }}">{{ theme.rate }}</span> %</span>
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{# Carte de ressource pédagogique #}
{% macro resource_card(r, types) %}
    {% set icons = { fiche: '📄', video: '🎬', presentation: '🖥️', quiz: '❓', document: '📘' } %}
    <a href="{{ path('resources_show', { slug: r.slug }) }}" class="res-card">
        <span class="res-icon" aria-hidden="true">{{ icons[r.type] }}</span>
        <span class="res-body">
            <span class="res-type">{{ types[r.type] }} · {{ r.format }}</span>
            <strong>{{ r.title }}</strong>
            <span class="res-meta">
                {{ r.levels ? r.levels|join(', ') : 'Tous niveaux' }}
            </span>
        </span>
    </a>
{% endmacro %}

{# Libellé de source d'un message #}
{% macro msg_icon(kind) %}{{ { message: '📢', ressource: '📚', module: '🎓' }[kind] }}{% endmacro %}
