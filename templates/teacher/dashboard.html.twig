{% extends 'layouts/portal.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block page_title %}Bonjour {{ teacher.name|split(' ')|first }} 👋{% endblock %}
{% block page_subtitle %}Préparez et débriefez vos séances Saferoads. Vous ne voyez que vos propres classes et sessions.{% endblock %}
{% block page_actions %}
    <a href="{{ path('resources_index') }}#preparer" class="btn btn-outline">📄 Fiche de séance</a>
{% endblock %}

{% block content %}
<div class="dash-grid">
    {# ---- Ma prochaine séance ---- #}
    <section class="panel panel-hero">
        {% if next %}
            <div>
                <span class="kicker-sm">Ma prochaine séance</span>
                <h2>{{ next.class }} — {{ next.path }}</h2>
                <p class="muted">{{ next.date|format_datetime(pattern: "EEEE d MMMM 'à' HH'h'mm", locale: 'fr')|capitalize }}</p>
                <div class="hero-actions">
                    <a href="{{ path('teacher_session', { code: next.code }) }}" class="btn btn-primary">▦ Afficher le QR Code</a>
                    <a href="{{ path('resources_index') }}#preparer" class="btn btn-ghost">Préparer la séance</a>
                </div>
            </div>
            <div class="code-box" aria-label="Code session">
                <small>Code session</small>
                <strong>{{ next.code }}</strong>
            </div>
        {% else %}
            <p>Aucune séance planifiée. Les codes session sont attribués par AC.</p>
        {% endif %}
    </section>

    {# ---- Chiffres ---- #}
    <section class="kpis">
        {{ ui.kpi('Sessions réalisées', stats.done, '', stats.planned ~ ' planifiée(s)', '🎮') }}
        {{ ui.kpi('Participants', stats.participants, '', 'sur mes sessions terminées', '👥') }}
        {{ ui.kpi('Taux de complétion', stats.completion, '%', stats.completed ~ ' parcours terminés', '✅') }}
        {{ ui.kpi('Ma formation MOOC', teacher.mooc, '%', 'de progression', '🎓') }}
    </section>

    {# ---- Résultats pédagogiques ---- #}
    <section class="panel span-2">
        <div class="panel-head">
            <h2>Résultats de mes classes</h2>
            <a href="{{ path('teacher_results') }}" class="link">Voir le détail →</a>
        </div>
        <p class="muted">Réussite par thématique, toutes sessions terminées confondues.</p>
        <div class="split">
            {{ ui.themes(stats.themes, stats.weakest.key ?? null) }}
            <div class="insights">
                {% if stats.strongest %}
                    <div class="insight insight-good">
                        <span class="insight-icon" aria-hidden="true">💪</span>
                        <span><small>Thématique forte</small><strong>{{ stats.strongest.label }} <span class="nw">— {{ stats.strongest.rate }} %</span></strong></span>
                    </div>
                    <div class="insight insight-warn">
                        <span class="insight-icon" aria-hidden="true">⚠️</span>
                        <span><small>Point d'attention</small><strong>{{ stats.weakest.label }} <span class="nw">— {{ stats.weakest.rate }} %</span></strong></span>
                    </div>
                {% endif %}
                {% if debrief %}
                    <a href="{{ path('resources_show', { slug: debrief.slug }) }}" class="insight insight-action">
                        <span class="insight-icon" aria-hidden="true">🗣️</span>
                        <span><small>Support de débrief conseillé</small><strong>{{ debrief.title }}</strong></span>
                        <span aria-hidden="true">→</span>
                    </a>
                {% endif %}
            </div>
        </div>
    </section>

    {# ---- Dernières sessions ---- #}
    <section class="panel">
        <div class="panel-head">
            <h2>Mes dernières sessions</h2>
            <a href="{{ path('teacher_sessions') }}" class="link">Toutes →</a>
        </div>
        <ul class="list">
            {% for s in recent %}
                <li>
                    <a href="{{ path('teacher_session', { code: s.code }) }}" class="list-row">
                        <span>
                            <strong>{{ s.class }}</strong> · {{ s.code }}
                            <small class="muted d-block">{{ s.date|date('d/m/Y') }} — {{ s.participants }} participants</small>
                        </span>
                        {{ ui.bar(s.completion) }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </section>

    {# ---- Formation ---- #}
    <section class="panel">
        <div class="panel-head">
            <h2>Ma formation</h2>
            <a href="{{ path('mooc_index') }}" class="link">MOOC →</a>
        </div>
        <div class="ring" style="--p: {{ teacher.mooc }}">
            <span><strong data-count="{{ teacher.mooc }}">{{ teacher.mooc }}</strong>%</span>
        </div>
        {% if module %}
            <p class="center muted">À reprendre : <strong>Module {{ module.number }} — {{ module.title }}</strong></p>
            <a href="{{ path('mooc_module', { slug: module.slug }) }}" class="btn btn-primary btn-block">Reprendre la formation</a>
        {% endif %}
    </section>

    {# ---- Messages ---- #}
    <section class="panel">
        <div class="panel-head">
            <h2>Messages Saferoads / DSR</h2>
            <a href="{{ path('messages_index') }}" class="link">Tous →</a>
        </div>
        <ul class="list">
            {% for id, m in messages %}
                <li>
                    <a href="{{ path('messages_show', { id: id }) }}" class="list-row {{ m.read ? '' : 'is-unread' }}">
                        <span>
                            {{ ui.msg_icon(m.kind) }} <strong>{{ m.title }}</strong>
                            <small class="muted d-block">{{ m.source }} · {{ m.date|date('d/m/Y') }}</small>
                        </span>
                        {% if not m.read %}<span class="dot" title="Non lu"></span>{% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </section>
</div>
{% endblock %}
