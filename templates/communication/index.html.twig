{% extends 'layouts/portal.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block page_title %}Communications{% endblock %}
{% block page_subtitle %}Publications DSR / Saferoads vers les enseignants inscrits — notification dans la plateforme et e-mail professionnel.{% endblock %}
{% block page_actions %}<a href="{{ path('com_new') }}" class="btn btn-primary">＋ Nouvelle communication</a>{% endblock %}

{% block content %}
<section class="kpis kpis-3">
    {{ ui.kpi('Communications', communications|length, '', (communications|filter(c => c.status == 'planifiee')|length) ~ ' planifiée(s)', '📨') }}
    {{ ui.kpi('Envois (publiées)', recipients, '', 'notifications distribuées', '📬') }}
    {{ ui.kpi('Taux de consultation', recipients ? (reads / recipients * 100)|round : 0, '%', reads ~ ' consultations', '👁') }}
</section>

<section class="panel">
    <div class="panel-head"><h2>Historique</h2></div>
    <ul class="inbox">
        {% for c in communications %}
            {% set rate = c.recipients ? (c.reads / c.recipients * 100)|round : 0 %}
            <li style="--i: {{ loop.index0 }}">
                <div class="inbox-row">
                    <span class="inbox-icon" aria-hidden="true">{{ ui.msg_icon(c.kind) }}</span>
                    <span class="inbox-body">
                        <strong>{{ c.title }}</strong>
                        <small class="muted">{{ c.source }} · {{ c.date|date('d/m/Y') }} · 🎯 {{ c.audience }}</small>
                    </span>
                    <span class="diffusion">
                        {% if c.status == 'publiee' %}
                            <small>Disponible pour <strong>{{ c.recipients }}</strong> enseignants, consultée par <strong>{{ c.reads }}</strong></small>
                            {{ ui.bar(rate) }}
                        {% else %}
                            <span class="pill pill-planifiee">🗓 Planifiée · {{ c.recipients }} destinataires</span>
                        {% endif %}
                    </span>
                </div>
            </li>
        {% endfor %}
    </ul>
</section>
{% endblock %}
